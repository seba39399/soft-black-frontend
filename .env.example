# Variables de entorno de la Plantilla (todas con prefijo NEXT_PUBLIC_).
# Copia este archivo a .env.local y completa los valores.
# No incluyas credenciales de AWS ni el client secret de Cognito:
# el App Client debe ser público (sin secret).

# ID del User Pool de Cognito (Amplify infiere la región de su formato <region>_xxxx).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# ID del App Client de Cognito (público, sin secret).
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# URL base de la API externa (sin barra final).
NEXT_PUBLIC_API_BASE_URL=

# OPCIONAL. Minutos que dura la sesión desde el login (entero de 5 a 1440).
# Si se deja vacía, 60. Ver docs/03-autenticacion.md §9.
NEXT_PUBLIC_SESSION_MAX_MINUTES=
