# Normaliza finales de línea a LF en el repositorio (Vercel compila en Linux).
* text=auto eol=lf

# Scripts de Windows conservan CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binarios: Git no toca sus finales de línea.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary

# Parches: se conservan tal cual (pueden contener CRLF a propósito).
*.patch -text
